# ==========================================
# Accessible Place Finder - Environment Variables
# ==========================================

# Port for the Express backend server
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/accessible_place_finder?retryWrites=true&w=majority
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/accessible_place_finder
MONGODB_URI=mongodb://127.0.0.1:27017/accessible_place_finder

# JWT Secret Key (replace with a long, cryptographically strong random string)
JWT_SECRET=super_secret_jwt_key_accessible_place_finder_2026_secure!
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=uploads
